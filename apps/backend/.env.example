# ─── Database ────────────────────────────────────────────────────────────────
# Local: postgresql://veerha:veerha123@localhost:5432/veerha_wms_dev
# Production (Neon): get connection string from https://neon.tech
DATABASE_URL=postgresql://user:password@localhost:5432/veerha_wms_dev

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
# Dev:        http://localhost:8080,http://localhost:8090
# Production: https://app-veerha.pages.dev,https://veerha-admin.pages.dev
CORS_ORIGIN=http://localhost:8080,http://localhost:8090

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate strong secrets: openssl rand -base64 64
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long-change-this
JWT_REFRESH_SECRET=your-super-secret-refresh-key-minimum-32-characters-long-change-this

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
# When SMTP_HOST is empty, EmailService becomes a no-op (logs only) — safe for
# dev, but note that notification_email_queue rows are still marked 'sent'. On
# boot the service runs transporter.verify() and logs either
#   "SMTP ready: host:port (secure=…) as user"  or  "SMTP VERIFY FAILED …".
# Check that line first when mail goes missing. Full guide: dev/EMAIL-SETUP.md
SMTP_HOST=
SMTP_PORT=587
# "true" = implicit TLS (port 465). "false" = plain connect + STARTTLS (587/2587/2525/1025).
# If left empty it is derived from the port (465 → true, everything else → false).
SMTP_SECURE=false
# Leave SMTP_USER empty for a server that takes no credentials (Mailpit/MailHog)
# — the AUTH command is then skipped entirely.
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Veerha WMS <noreply@veerha.in>"
APP_URL=http://localhost:8080

# ─── Email option A: Mailpit (local development) ──────────────────────────────
# `docker compose up -d mailpit`, then read everything at http://localhost:8025
# Nothing leaves your machine, no account needed, no credentials.
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Veerha WMS (dev) <noreply@veerha.local>"

# ─── Email option B: Resend (recommended for staging/production) ──────────────
# Standard SMTP — no code change needed, these variables are the whole setup.
# The username is the literal string "resend"; the password is the API key.
# SMTP_FROM must use a domain VERIFIED in Resend, otherwise sends are rejected.
# Free tier: 3,000 emails/month, 100/day. Until a domain is verified you can
# only send to the email address that owns the Resend account.
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465                 # or 587 / 2587 with SMTP_SECURE=false (STARTTLS)
# SMTP_SECURE=true              # true for 465, false for 587/2587
# SMTP_USER=resend              # literally "resend" — not your email
# SMTP_PASS=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx   # Resend API key, never commit it
# SMTP_FROM="Veerha WMS <noreply@veerha.in>"

# ─── Scheduled jobs ───────────────────────────────────────────────────────────
# In-process cron jobs for the notification engine (email flush, hourly digest,
# daily summary, retention purge, putaway-overdue scan, batch-expiry scan).
# Default: true (unset behaves as true) — leave it alone for a single instance.
#
# Safe to run on several instances: each job takes a Postgres advisory lock, so
# exactly one instance executes a given tick and the rest skip it. Set to false
# only to silence the crons entirely on an instance — e.g. web instances once a
# dedicated worker owns the schedule.
ENABLE_SCHEDULED_JOBS=true
